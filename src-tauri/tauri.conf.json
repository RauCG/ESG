{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ESG",
  "version": "0.1.0",
  "identifier": "com.esg.app",
  "build": {
    "beforeDevCommand": "npm run start",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist/ESG/browser"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "ESG",
        "width": 1280,
        "height": 820,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": []
  }
}